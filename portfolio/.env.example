# EmailJS (formulario de contacto). Copiá este archivo a .env.local y completá tus propios valores.
# Se crean en https://dashboard.emailjs.com: un Email Service, un Email Template y la Public Key de la cuenta.
# La plantilla recibe: {{from_name}}, {{reply_to}} y {{message}}.
# Sin estos valores el formulario valida igual y, al enviar, muestra un aviso con el correo directo.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
